def pozdrav(meno, pohlavie):
    if (pohlavie == "m"):
        print (f"Toto je pozdrav pre {meno}a")
    elif (meno[-1] != "a"):
        print(f"Toto je pozdrav pre {meno[0:-1]}o")
    
    else:
        print (f"Toto je pozdrav pre {meno[0:-1]}u")
    print("ahoj" + meno)


pozdrav(" jakub", "m")

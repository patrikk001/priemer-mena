#include <stdio.h>

typedef struct
{
    char nazovproduktu[50];
    int pocet;
    float cena;
} Product;

int main(void) {
    int n;
    
    printf("Zadajte pocet produktov (max 10): ");
    if (scanf("%d", &n) != 1 || n <= 0 || n > 10) {
        printf("Neplatny vstup. Zadajte cislo od 1 do 10.\n");
        return 1; 
    }

    Product produkty[10];
    float celkova_cena = 0;

    for(int i = 0; i < n; i++) {
        printf("\n--- PRODUKT %d ---\n", i + 1);
        printf("Nazov produktu: ");
        scanf("%s", produkty[i].nazovproduktu);
        printf("Cena produktu: ");
        scanf("%f", &produkty[i].cena);
        printf("Pocet kusov: ");
        scanf("%d", &produkty[i].pocet);
    }

   
    printf("\n\n--- PREHLAD NAKUPU ---\n");
    for(int i = 0; i < n; i++) {
        float spolu = produkty[i].cena * produkty[i].pocet;
        celkova_cena += spolu;
        
        printf("%d. %s | Cena za kus: %.2f | Pocet: %d ks | Spolu: %.2f EUR\n", 
               i + 1, produkty[i].nazovproduktu, produkty[i].cena, produkty[i].pocet, spolu);
    }
    
    printf("--------------------------------------\n");
    printf("CELKOVA SPOLU: %.2f EUR\n", celkova_cena);

    if (celkova_cena > 50) {
        float zlavnena_cena = celkova_cena * 0.9;
        printf("\nZiskavas zlavu 10%% (nakup nad 50 EUR)!\n");
        printf("Cena po zleve: %.2f EUR\n", zlavnena_cena);
    }

    return 0;
}